{
  "name": "@nem035/agentevals",
  "version": "1.0.0",
  "description": "Evals you can trust: per-case pass rates, broken runs kept out of the score, score ranges, a luck check for comparisons, and held-out cases.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agentevals": "./bin/agentevals.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run build && npm run test:run"
  },
  "keywords": [
    "ai",
    "eval",
    "evals",
    "evaluation",
    "llm",
    "agent",
    "testing",
    "llm-as-judge",
    "mcnemar"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nem035/agentevals.git"
  },
  "bugs": {
    "url": "https://github.com/nem035/agentevals/issues"
  },
  "homepage": "https://agentevals.dev",
  "dependencies": {
    "commander": "^13.0.0",
    "glob": "^13.0.0",
    "jiti": "^2.4.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
